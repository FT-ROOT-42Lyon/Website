generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Identity ────────────────────────────────────────────────────────────────
model User {
  id          Int       @id @default(autoincrement())
  ft42Id      Int       @unique @map("ft42_id")
  login       String    @unique
  email       String
  displayName String?   @map("display_name")
  avatarUrl   String?   @map("avatar_url")
  isStaff     Boolean   @default(false) @map("is_staff")
  // Global score = sum of every solve, regardless of event.
  score       Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  sessions     Session[]
  eventMembers EventMember[]
  solves       ChallengeSolve[]

  @@map("users")
}

model Session {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  jti       String   @unique
  userAgent String?  @map("user_agent")
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model OAuthState {
  id        Int      @id @default(autoincrement())
  state     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  @@map("oauth_states")
}

// ─── Challenge catalog ───────────────────────────────────────────────────────
model Category {
  id                 Int      @id @default(autoincrement())
  slug               String   @unique
  name               String   @unique
  description        String   @default("")
  exploitDescription String   @default("") @map("exploit_description")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  challenges Challenge[]

  @@map("categories")
}

model Challenge {
  id          Int        @id @default(autoincrement())
  slug        String     @unique
  title       String
  description String     @default("")
  categoryId  Int        @map("category_id")
  score       Int        @default(100)
  difficulty  Difficulty @default(MEDIUM)
  flagHash    String?    @map("flag_hash")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  category        Category            @relation(fields: [categoryId], references: [id])
  resources       ChallengeResource[]
  solves          ChallengeSolve[]
  eventChallenges EventChallenge[]

  @@map("challenges")
}

enum Difficulty {
  VERY_EASY
  EASY
  MEDIUM
  HARD
  VERY_HARD
}

enum ResourceType {
  FILE
  LINK
}

model ChallengeResource {
  id          Int          @id @default(autoincrement())
  challengeId Int          @map("challenge_id")
  type        ResourceType
  label       String
  target      String
  position    Int          @default(0)

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@map("challenge_resources")
}

// ─── Events ──────────────────────────────────────────────────────────────────
// An event is a time-bounded competition: it groups users (members) and a
// curated set of challenges. Solving an event-listed challenge during the
// window also credits the user's per-event score.
model Event {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  name        String   @unique
  description String   @default("")
  imageUrl    String?  @map("image_url")
  startsAt    DateTime @map("starts_at")
  endsAt      DateTime @map("ends_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members    EventMember[]
  challenges EventChallenge[]

  @@map("events")
}

model EventMember {
  id       Int      @id @default(autoincrement())
  userId   Int      @map("user_id")
  eventId  Int      @map("event_id")
  // Updated by the scoring engine when a member solves an event-challenge
  // within the event window.
  score    Int      @default(0)
  joinedAt DateTime @default(now()) @map("joined_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@map("event_members")
}

// Many-to-many tying challenges to events. A challenge only awards event score
// for events that include it (and only during their window).
model EventChallenge {
  id          Int @id @default(autoincrement())
  eventId     Int @map("event_id")
  challengeId Int @map("challenge_id")

  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([eventId, challengeId])
  @@map("event_challenges")
}

model ChallengeSolve {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  challengeId  Int      @map("challenge_id")
  scoreAwarded Int      @map("score_awarded")
  solvedAt     DateTime @default(now()) @map("solved_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId])
  @@map("challenge_solves")
}
